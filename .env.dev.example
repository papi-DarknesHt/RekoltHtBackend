# Copier ce fichier en ".env.dev" et renseigner les vraies valeurs (développement local)
# Le fichier ".env.dev" ne doit jamais être commité (voir .gitignore)
# Chargé automatiquement par BackendRekoltHt/settings/dev.py

# Clé secrète Django (une valeur de secours non sécurisée est utilisée si absente en dev)
SECRET_KEY=change-moi-en-local

# Identifiants OAuth2 Google
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=

# Clé secrète reCAPTCHA (vérification serveur, voir Registration/views.py::
# _verifier_recaptcha, utilisée par la création d'un compte ADM) — obtenue sur
# https://www.google.com/recaptcha/admin avec le MÊME site que celui utilisé
# pour VITE_RECAPTCHA_KEY côté frontend (clé de SITE différente de la clé
# SECRÈTE : les deux viennent du même enregistrement reCAPTCHA). Laisser vide
# désactive la vérification côté serveur (dev sans clé).
RECAPTCHA_SECRET_KEY=

# Configuration email SMTP (envoi des codes de réinitialisation de mot de passe, etc.)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Clé maître de chiffrement des sauvegardes (voir Sauvegarde/services/
# chiffrement_service.py) — générer une fois avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Ne JAMAIS changer cette valeur après coup sans conserver l'ancienne : les
# sauvegardes déjà chiffrées avec l'ancienne clé deviendraient illisibles.
BACKUP_MASTER_KEY=

# Clé maître de chiffrement des messages support (voir Messagerie/services/
# support_chiffrement_service.py) — générer une fois avec la même commande
# que ci-dessus. Contrairement à BACKUP_MASTER_KEY, changer cette valeur rend
# uniquement les anciens messages support (pas les sauvegardes) illisibles.
SUPPORT_MASTER_KEY=

# Clé maître de chiffrement de la messagerie privée 1:1 (voir Messagerie/
# services/messages_chiffrement_service.py) — même commande que ci-dessus.
# Changer cette valeur rend uniquement les anciens messages privés illisibles.
MESSAGES_MASTER_KEY=

# Identifiants OAuth2 dédiés à l'upload des sauvegardes sur Google Drive
# (Google Cloud Console : activer l'API Drive, créer un identifiant "Application
# Web", ajouter GOOGLE_DRIVE_REDIRECT_URI ci-dessous comme URI de redirection
# autorisée). Peut réutiliser le même projet Google Cloud que
# SOCIAL_AUTH_GOOGLE_OAUTH2_KEY/SECRET ci-dessus. Laisser vide désactive la
# destination "Google Drive" (la destination "locale" reste disponible).
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/Sauvegarde/google/callback/

# URL du frontend (redirection après le consentement Google Drive)
FRONTEND_URL=http://localhost:5173

# Chemin vers le python d'un second environnement dédié à DeepFace (voir
# requirements-face.txt et Registration/services/face_service.py) — incompatible
# en environnement partagé avec paddleocr/paddlepaddle (conflit protobuf).
# Ex Windows : C:\chemin\vers\venv_face\Scripts\python.exe
# Ex Linux/macOS : /chemin/vers/venv_face/bin/python
# Laisser vide désactive la vérification faciale automatique (revue manuelle
# systématique, voir _lancer_verification_faciale, Registration/views.py)
FACE_VENV_PYTHON=

# Clé API OpenRouter (passerelle vers de nombreux modèles — GPT, Claude...),
# pour l'assistant IA du chatbot (voir Messagerie/services/chatbot_ia_service.py)
# — obtenue sur https://openrouter.ai/settings/keys. Laisser vide désactive
# l'assistant IA (ChatbotVendeur.jsx propose alors directement de contacter
# un admin). CHATBOT_IA_MODEL : voir https://openrouter.ai/models pour la
# liste des modèles disponibles et leurs tarifs.
OPENROUTER_API_KEY=
CHATBOT_IA_MODEL=openai/gpt-4o
